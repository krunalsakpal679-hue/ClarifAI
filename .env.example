# ==============================================================================
# ClarifAI Full-Stack Environment Configuration Template
# PRD v2.3 Chapter 35 (DevOps & Infrastructure Environment Specification)
# ==============================================================================

# Core System Environment (development / production)
ENVIRONMENT=development

# Database Settings (PostgreSQL)
POSTGRES_DB=clarifai_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Secret Keys (Generate secure random secrets in production)
JWT_SIGNING_KEY=dev_jwt_signing_key_secret_clarifai_2026
INTERNAL_SERVICE_SECRET=clarifai_internal_secret_token_2026

# Groq Cloud LLM API Credentials (Required for live Groq LLM inference)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL_NAME=openai/gpt-oss-20b
LLM_REQUEST_TIMEOUT_SECONDS=30

# Qdrant Vector Database
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=clarifai_clause_embeddings

# Frontend Environment Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCKS=false
