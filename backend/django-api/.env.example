# ClarifAI Django REST API Environment Configuration Example
# Copy to .env for local environment settings (Do NOT commit secrets)

ENVIRONMENT=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clarifai_db
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
JWT_SIGNING_KEY=your_jwt_signing_key_here
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
MAX_UPLOAD_SIZE_MB=10
