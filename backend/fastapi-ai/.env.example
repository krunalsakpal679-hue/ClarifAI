# ClarifAI AI Microservice Environment Configuration Example
# Copy to .env for local environment configuration (Do NOT commit actual secret values)

# Groq API Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL_NAME=openai/gpt-oss-20b
LLM_REQUEST_TIMEOUT_SECONDS=30

# Qdrant Vector Database Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=clarifai_clause_embeddings

# Model Checkpoint Paths & Overrides (Fine-Tuned Validated Checkpoints)
LEGAL_BERT_MODEL_NAME=backend/fastapi-ai/training/checkpoints/legal-bert/v2.0
EMBEDDING_MODEL_NAME=backend/fastapi-ai/training/checkpoints/multilingual-e5/v1.1
BART_MODEL_NAME=facebook/bart-base

# Microservice Network Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
INTERNAL_SERVICE_SECRET=your_internal_service_secret_here
